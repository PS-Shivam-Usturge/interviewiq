# Copy this to .env and fill in your keys

# ── Claude Agent SDK (ALL LLM calls — orchestrator, sub-agents, eval judge) ──
# Run `claude setup-token` in your terminal to generate this token.
# Works with a Claude Pro/Max subscription — no separate API billing.
# (If you are already logged in to Claude Code on this machine, the SDK can also use that login.)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-token-here

# ── Groq (Whisper STT only — Claude has no audio model) ──────────────────────
# Get a free key at: https://console.groq.com
# Only used for POST /api/transcribe — not for any LLM text calls.
GROQ_API_KEY=your_groq_api_key_here

PORT=3001

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for X-API-Key header authentication
# (REST API and the A2A endpoint). Leave blank to disable auth — local dev only.
# Example: API_KEYS=secret-key-1,secret-key-2
API_KEYS=

# ── Agent runtime (all optional — defaults shown) ────────────────────────────
# Per-call timeout and retry for every Claude Agent SDK query()
# AGENT_TIMEOUT_MS=180000
# Timeout for orchestrator phases whose tools run whole sub-agents (setup, report)
# AGENT_LONG_TIMEOUT_MS=360000
# AGENT_RETRIES=1
# Resume the same SDK session across setup → answers → report (falls back automatically)
# AGENT_SESSION_RESUME=true
# Model override (default: the Claude Code CLI default model)
# AGENT_MODEL=
# Thinking effort per role: low | medium | high (lower = faster turns for the candidate)
# SUBAGENT_EFFORT=low          # parseAgent, answerAgent, eval judge
# GENERATION_EFFORT=medium     # questionAgent, reportAgent
# ORCHESTRATOR_EFFORT=medium   # lead interviewer decisions

# ── A2A interface ─────────────────────────────────────────────────────────────
# Public base URL advertised in /.well-known/agent-card.json (default http://localhost:PORT)
# PUBLIC_BASE_URL=
# Frontend URL used for candidate/monitor/report links returned over A2A
# FRONTEND_URL=http://localhost:5173

# LOG_LEVEL=info
